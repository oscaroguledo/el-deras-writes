ENVIRONMENT=dev            # dev | test | production
SECRET_KEY=replace-with-a-long-random-secret-of-32-or-more-chars
DATABASE_URL=postgresql://user:password@host:5432/dbname   # SQLite if unset
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Regex for preview deployments, e.g. Cloudflare Pages:
CORS_ALLOWED_ORIGIN_REGEX=

# Email via Brevo. Nothing is sent while BREVO_API_KEY is empty.
BREVO_API_KEY=
BREVO_FROM_EMAIL="El Dera's Writes <noreply@yourdomain.com>"
SUPPORT_EMAIL=             # gets "new feedback" and "new comment" notifications

# Optional owner account, created/updated at startup (12+ chars in production)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=
